# Copy to .env and edit. Never commit .env.

# ---------- answering ----------
# auto (default): Mistral, then Gemini, then Ollama (each only if configured), then offline quoted answers
LLM_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Backup model: used automatically if Mistral fails or is rate-limited (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b

# ---------- parsing ----------
# auto (default): the router picks the engine per page. Or force: tesseract | easyocr | paddleocr | vision
OCR_ENGINE=auto
VISION_MODEL=qwen3-vl:2b
# DISABLE_ENGINES=vision,easyocr

# ---------- retrieval ----------
# minilm (default) | ollama (nomic-embed-text) | hashing (offline demo only)
EMBEDDER=minilm
# For non-English documents:
# ST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Vision-native retrieval of visual pages (GPU): none | colpali
VISUAL_RETRIEVER=none

